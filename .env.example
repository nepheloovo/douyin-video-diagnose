# Copy to .env and fill in secrets locally. Never commit .env.
# Render: set the same names in the service environment.
#
# OPENAI_API_KEY wins when it is non-empty, including over DEEPSEEK_API_KEY.
# Leave OPENAI_BASE_URL and OPENAI_MODEL unset to keep the provider defaults
# (OpenAI: https://api.openai.com/v1 + gpt-4o-mini;
#  DeepSeek-only: https://api.deepseek.com + deepseek-chat).

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Used only when OPENAI_API_KEY is empty.
# OPENAI_BASE_URL / OPENAI_MODEL still override the DeepSeek host and model.
# DEEPSEEK_API_KEY=

# Optional stronger model for the judge stage. When all of these are unset,
# the judge uses the same client as the experts.
# JUDGE_MODEL wins over JUDGE_OPENAI_MODEL when both are set.
# JUDGE_OPENAI_API_KEY=
# JUDGE_OPENAI_BASE_URL=
# JUDGE_MODEL=
# JUDGE_OPENAI_MODEL=
